{
  "name": "@pokenitsu/arma",
  "private": true,
  "type": "module",
  "description": "Arma tu colección: el Full de impresiones de un Pokémon, reglas y procedencia (solo local)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,yellow \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=../../.env server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@pokenitsu/auth": "workspace:*",
    "@pokenitsu/core": "workspace:*",
    "@pokenitsu/inventory": "workspace:*",
    "fastify": "^5.12.7",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
