{
  "name": "pokenitsu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "start": "pnpm build && pnpm --filter @pokenitsu/api start",
    "dev": "pnpm build && pnpm --filter @pokenitsu/api dev",
    "sync": "pnpm --filter @pokenitsu/api sync",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "imagenes:descargar": "pnpm --filter @pokenitsu/api imagenes:descargar",
    "imagenes:estado": "pnpm --filter @pokenitsu/api imagenes:estado",
    "arma": "pnpm --filter @pokenitsu/core --filter @pokenitsu/auth build && pnpm --filter @pokenitsu/arma dev"
  }
}
